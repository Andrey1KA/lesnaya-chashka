# Настройки для локального запуска. Все значения тестовые — менять ничего не нужно.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: пользователь и база создаются скриптом setup_db.sql (или docker compose up -d),
# данные загружаются из database/lesnaya_chashka.sql — см. README.md.
POSTGRES_DB=lesnaya_chashka_v2
POSTGRES_USER=lesnaya
POSTGRES_PASSWORD=lesnaya-local-2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Период акции (даты покупки, которые принимаются в чеках).
PROMO_START=2026-12-01
PROMO_END=2027-01-31

# Тестовые учётные записи из базы.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-local-2026
TEST_USER_PASSWORD=Lesnaya-test-2026
